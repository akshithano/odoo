{
  "name": "subscription-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Subscription Management & Billing System - 4-Member Monorepo Foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=@odoo/backend\" \"npm run dev --workspace=@odoo/frontend\"",
    "dev:frontend": "npm run dev --workspace=@odoo/frontend",
    "dev:backend": "npm run dev --workspace=@odoo/backend",
    "build": "npm run build --workspace=@odoo/shared && npm run build --workspace=@odoo/backend && npm run build --workspace=@odoo/frontend",
    "build:shared": "npm run build --workspace=@odoo/shared",
    "build:frontend": "npm run build --workspace=@odoo/frontend",
    "build:backend": "npm run build --workspace=@odoo/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run db:generate --workspace=@odoo/backend",
    "db:migrate": "npm run db:migrate --workspace=@odoo/backend",
    "db:seed": "npm run db:seed --workspace=@odoo/backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
