# ==============================================================================
# Subscription Management System - Environment Configuration Template
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Environment & Application Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=5001

# ------------------------------------------------------------------------------
# CORS & Client URLs
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5001/api/v1

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database Configuration
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# ------------------------------------------------------------------------------
POSTGRES_USER=odoo_user
POSTGRES_PASSWORD=odoo_secure_password
POSTGRES_DB=odoo_subscription_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://odoo_user:odoo_secure_password@localhost:5432/odoo_subscription_db?schema=public

# ------------------------------------------------------------------------------
# Redis 7 & BullMQ Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Security & JWT Authentication (Member 1)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Email / SMTP Notification Service (Member 4 / Member 1)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
EMAIL_FROM="Subscription Platform <no-reply@subscription.local>"

# ------------------------------------------------------------------------------
# Payment Gateway Configuration (Member 3)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=placeholder_secret
